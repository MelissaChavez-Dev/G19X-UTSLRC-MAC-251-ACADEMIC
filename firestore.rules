rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isTeamMember(teamId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }

    match /surveyTemplates/{templateId} {
      allow read: if resource.data.status == "published" || isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /responses/{responseId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin();
      // El usuario solo puede apagar su propia bandera de cambio de contraseña;
      // todo lo demás lo modifica el admin (normalmente vía Cloud Function).
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword"])
            && request.resource.data.mustChangePassword == false);
      allow delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow get: if isAdmin() || isTeamMember(teamId);
      allow list: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.memberIds);
      // La creación y la unión por código pasan por Cloud Functions
      // (para validar el joinCode sin exponer la lista de códigos).
      allow write: if false;

      match /tasks/{taskId} {
        allow read: if isAdmin() || isTeamMember(teamId);
        allow create, update, delete: if isAdmin() || isTeamMember(teamId);
      }
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow create: if isSelf(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          "userId", "type", "timestamp", "action", "projectId", "projectName",
          "taskId", "taskTitle", "fromStatus", "toStatus", "surveyTitle"
        ]);
      allow read: if isSelf(resource.data.userId);
      allow update, delete: if false;
    }

    match /presenceSummary/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && docId.matches("^" + request.auth.uid + "_.*"));
      allow write: if false; // exclusivo de la Cloud Function programada
    }

    match /surveyCompletions/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && docId.matches("^" + request.auth.uid + "_.*");
      allow update, delete: if false;
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departureLog/{logId} {
      allow read: if isAdmin();
      allow write: if false; // exclusivo de las Cloud Functions (Admin SDK)
    }

    match /metricsCatalog/{metricId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /externalDataImports/{importId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "sourceFileName", "sourceType", "createdBy", "createdAt", "completedAt",
          "status", "acceptedRows", "rejectedRows", "inputRows", "smallCohortGroups"
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "uploading"
        && request.resource.data.sourceType in ["csv", "xlsx"]
        && request.resource.data.sourceFileName is string
        && request.resource.data.sourceFileName.size() <= 200
        && request.resource.data.acceptedRows is int
        && request.resource.data.rejectedRows is int
        && request.resource.data.inputRows is int
        && request.resource.data.smallCohortGroups is int;
      allow update: if isAdmin()
        && resource.data.status == "uploading"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "completedAt", "failureCode"
        ])
        && request.resource.data.status in ["complete", "failed"];
      allow delete: if false;

      match /records/{recordId} {
        function parentImport() {
          return get(/databases/$(database)/documents/externalDataImports/$(importId)).data;
        }

        allow read: if isAdmin() && parentImport().status == "complete";
        allow create: if isAdmin()
          && parentImport().status == "uploading"
          && request.resource.data.keys().hasOnly([
            "sourceRowNumber", "date", "department", "metrics"
          ])
          && request.resource.data.sourceRowNumber is int
          && request.resource.data.sourceRowNumber >= 2
          && request.resource.data.sourceRowNumber <= 5001
          && request.resource.data.date is timestamp
          && request.resource.data.department is string
          && request.resource.data.department.size() > 0
          && request.resource.data.department.size() <= 120
          && request.resource.data.metrics is map
          && request.resource.data.metrics.keys().hasOnly([
            "participationRate", "psychSafety", "attritionRisk"
          ])
          && (
            !("participationRate" in request.resource.data.metrics)
            || (request.resource.data.metrics.participationRate is number
              && request.resource.data.metrics.participationRate >= 0
              && request.resource.data.metrics.participationRate <= 100)
          )
          && (
            !("psychSafety" in request.resource.data.metrics)
            || (request.resource.data.metrics.psychSafety is number
              && request.resource.data.metrics.psychSafety >= 1
              && request.resource.data.metrics.psychSafety <= 5)
          )
          && (
            !("attritionRisk" in request.resource.data.metrics)
            || (request.resource.data.metrics.attritionRisk is number
              && request.resource.data.metrics.attritionRisk >= 0
              && request.resource.data.metrics.attritionRisk <= 100)
          );
        allow update, delete: if false;
      }
    }
  }
}
