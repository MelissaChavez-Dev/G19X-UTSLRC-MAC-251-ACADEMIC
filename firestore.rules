rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.get("role", "") == "admin";
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isTeamMember(teamId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }
    function validTask(data) {
      return data.keys().hasOnly([
          "title", "description", "status", "origin", "sourceMetric", "createdBy",
          "assignedTo", "assignedToIds", "dueDate", "dueTime", "activity",
          "createdAt", "updatedAt", "completedAt", "comments"
        ])
        && data.keys().hasAll([
          "title", "description", "status", "origin", "sourceMetric", "createdBy",
          "assignedTo", "assignedToIds", "dueDate", "dueTime", "activity",
          "createdAt", "updatedAt"
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.description is string
        && data.description.size() <= 2000
        && data.status is string
        && data.status.matches("^[a-z0-9][a-z0-9_-]{0,79}$")
        && data.origin in ["manual", "ai_recommendation"]
        && (data.sourceMetric == null
          || (data.sourceMetric is string && data.sourceMetric.size() <= 100))
        && (data.createdBy == null || data.createdBy is string)
        && (data.assignedTo == null || data.assignedTo is string)
        && data.assignedToIds is list
        && (data.dueDate == null || data.dueDate is string)
        && (data.dueTime == null || data.dueTime is string)
        && data.activity is list
        && (!("completedAt" in data)
          || data.completedAt == null || data.completedAt is timestamp)
        && (!("comments" in data) || data.comments is list)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    function publicProfileNameMatches(uid) {
      let privateProfile = get(/databases/$(database)/documents/users/$(uid)).data;
      return request.resource.data.displayName is string
        && request.resource.data.displayName == privateProfile.get("displayName", "");
    }
    function profilePhotoBelongsTo(uid) {
      return request.resource.data.photoURL is string
        && (request.resource.data.photoURL == ""
          || request.resource.data.photoURL.matches(
            "^https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/profile-photos%2F"
            + uid
            + "%2Favatar\\?alt=media(&token=.*)?$"
          ));
    }
    match /surveyTemplates/{templateId} {
      allow read: if resource.data.status == "published" || isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /responses/{responseId} {
      allow create: if false; // Las respuestas solo se validan y escriben desde submit_survey_response.
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin();
      // El usuario solo puede apagar su propia bandera de cambio de contraseña;
      // todo lo demás lo modifica el admin (normalmente vía Cloud Function).
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword"])
            && request.resource.data.mustChangePassword == false);
      allow delete: if isAdmin();

      match /readAlerts/{alertId} {
        allow read, write: if isSelf(uid) && isAdmin();
      }
    }

    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.auth.token.role == "employee"
        && request.resource.data.keys().hasOnly(["displayName", "photoURL", "updatedAt"])
        && request.resource.data.displayName.size() <= 100
        && publicProfileNameMatches(uid)
        && profilePhotoBelongsTo(uid);
      allow update: if isSelf(uid)
        && request.auth.token.role == "employee"
        && request.resource.data.keys().hasOnly(["displayName", "photoURL", "updatedAt"])
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.displayName == resource.data.displayName
        && publicProfileNameMatches(uid)
        && profilePhotoBelongsTo(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photoURL", "updatedAt"]);
      allow delete: if isAdmin();
    }

    match /leaveRequests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false; // Las solicitudes se validan y crean mediante Cloud Function.
      allow update: if isAdmin()
          && resource.data.status == "pending"
          && request.resource.data.status in ["approved", "rejected"]
          && (request.resource.data.status != "rejected"
            || (request.resource.data.reviewNote is string
              && request.resource.data.reviewNote.size() >= 10
              && request.resource.data.reviewNote.size() <= 500
              && request.resource.data.reviewNote.matches("(?s).*\\S.*")))
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "reviewedBy", "reviewedAt", "reviewNote", "updatedAt"
          ])
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "cancelled"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "cancelledAt", "updatedAt"
            ]));
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow get: if isAdmin() || isTeamMember(teamId);
      allow list: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.memberIds);
      // La creación y la unión por código pasan por Cloud Functions
      // (para validar el joinCode sin exponer la lista de códigos).
      allow write: if false;

      match /tasks/{taskId} {
        allow read: if isAdmin() || isTeamMember(teamId);
        allow create: if (isAdmin() || isTeamMember(teamId))
          && validTask(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if (isAdmin() || isTeamMember(teamId))
          && validTask(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin() || isTeamMember(teamId);
      }
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow create: if isSelf(request.resource.data.userId)
        && request.resource.data.type in [
          "login", "navigation", "kanban_action", "survey_submit"
        ]
        && request.resource.data.timestamp == request.time
        && request.resource.data.keys().hasOnly([
          "userId", "type", "timestamp", "action", "projectId", "projectName",
          "taskId", "taskTitle", "fromStatus", "toStatus", "surveyTitle"
        ]);
      allow read: if isSelf(resource.data.userId);
      allow update, delete: if false;
    }

    match /presenceSummary/{docId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // exclusivo de la Cloud Function programada
    }

    match /surveyCompletions/{docId} {
      allow read: if isSelf(resource.data.userId);
      allow create, update, delete: if false; // La Cloud Function aplica la unicidad en una transacción.
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departureLog/{logId} {
      allow read: if isAdmin();
      allow write: if false; // exclusivo de las Cloud Functions (Admin SDK)
    }
  }
}
